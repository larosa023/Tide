<UserControl x:Class="Tide.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,4,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="Clear all" Command="{Binding ClearAlertsCommand}" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Alerts" />
                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap">
                    <Run Text="Tide tells you when an app goes online for the first time, or moves more than" />
                    <Run Text="{Binding SpikeThresholdMB, Mode=OneWay}" /><Run Text=" MB within a minute. Change this in Settings." />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <ListBox ItemsSource="{Binding Alerts}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <Border CornerRadius="8" Background="{DynamicResource Surface2Brush}" />
                                    <Image Source="{Binding Icon}" Width="22" Height="22" />
                                    <Border Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,-4,-4" Background="{DynamicResource AccentBrush}">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="9"
                                                   Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Dim}" FontSize="11"
                                                   Text="{Binding Time, Converter={StaticResource Ago}}" Margin="10,0,0,0" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton Style="{StaticResource BlockToggle}" Margin="0,0,6,0"
                                                  IsChecked="{Binding IsBlocked, Mode=OneWay}" IsEnabled="{Binding CanBlock}"
                                                  Command="{Binding DataContext.BlockFromAlertCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource GhostButton}" ToolTip="Show on Live page"
                                            Command="{Binding DataContext.ShowAppFromAlertCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="13" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" ToolTip="Dismiss"
                                            Command="{Binding DataContext.DismissAlertCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Alerts.Count, Converter={StaticResource Hidden}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextDimBrush}" />
                    <TextBlock Style="{StaticResource H2}" Text="All quiet" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Dim}" Text="New apps and data spikes will show up here."
                               Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
