<UserControl x:Class="Tide.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tide.Controls">
    <Grid Margin="24,4,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Banners ===== -->
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource DangerBrush}"
                    Visibility="{Binding MonitorError, Converter={StaticResource Visible}}">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource DangerBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding MonitorError}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource AccentBrush}"
                    Visibility="{Binding ShowUpdateBanner, Converter={StaticResource Visible}}">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="What's new" Command="{Binding OpenReleasesCommand}" Margin="0,0,4,0" />
                        <Button Style="{StaticResource GhostButton}" Content="Later" Command="{Binding DismissUpdateCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource AccentButton}" Content="Update now" Command="{Binding InstallUpdateCommand}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UpdateBannerText}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Dim}" Text="{Binding UpdateStatus}"
                                   Visibility="{Binding IsUpdating, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ===== Stats ===== -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="12" Foreground="{DynamicResource DownBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="DOWNLOAD" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding RateDown, Converter={StaticResource Rate}}" Style="{StaticResource H1}" FontSize="26" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="12" Foreground="{DynamicResource UpBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="UPLOAD" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding RateUp, Converter={StaticResource Rate}}" Style="{StaticResource H1}" FontSize="26" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="TODAY" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="↓" Foreground="{DynamicResource DownBrush}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TodayDown, Converter={StaticResource Bytes}}" Style="{StaticResource H1}" FontSize="20" Margin="4,0,16,0" />
                        <TextBlock Text="↑" Foreground="{DynamicResource UpBrush}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TodayUp, Converter={StaticResource Bytes}}" Style="{StaticResource H1}" FontSize="20" Margin="4,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0">
                        <Run Text="{Binding ActiveCount, Mode=OneWay}" /><Run Text=" apps active in the last minute" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ===== Graph ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12,16,12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="← All apps" Command="{Binding SelectAllCommand}" Margin="0,0,12,0"
                                Visibility="{Binding IsAppSelected, Converter={StaticResource Visible}}" />
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource DownBrush}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Dim}" Text="Download" Margin="6,0,14,0" VerticalAlignment="Center" />
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource UpBrush}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Dim}" Text="Upload" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="{Binding GraphTitle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Dim}" Text="{Binding GraphSubtitle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <c:LiveGraph Height="170" Series="{Binding GraphSeries}"
                             DownBrush="{DynamicResource DownBrush}" UpBrush="{DynamicResource UpBrush}"
                             DownFill="{DynamicResource DownFillBrush}" UpFill="{DynamicResource UpFillBrush}"
                             GridBrush="{DynamicResource LineBrush}" LabelBrush="{DynamicResource TextDimBrush}" />
            </DockPanel>
        </Border>

        <!-- ===== Toolbar ===== -->
        <DockPanel Grid.Row="3" Margin="0,0,0,8">
            <Grid Width="240" DockPanel.Dock="Left">
                <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,8,6" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" Margin="11,0,0,0" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextDimBrush}" />
                <TextBlock Text="Search apps" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextDimBrush}" FontSize="12.5"
                           Visibility="{Binding Text, ElementName=Search, Converter={StaticResource Hidden}}" />
            </Grid>
            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Active only"
                      IsChecked="{Binding HideIdleApps}" VerticalAlignment="Center" Margin="16,0,0,0" />
            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="Speed"
                                 IsChecked="{Binding SortMode, Converter={StaticResource Equals}, ConverterParameter=Speed}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="Today"
                                 IsChecked="{Binding SortMode, Converter={StaticResource Equals}, ConverterParameter=Today}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="Name"
                                 IsChecked="{Binding SortMode, Converter={StaticResource Equals}, ConverterParameter=Name}" />
                </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Dim}" Text="Sort by" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Border />
        </DockPanel>

        <!-- ===== App list ===== -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="6,6,6,6">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="10,4,18,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="108" />
                        <ColumnDefinition Width="108" />
                        <ColumnDefinition Width="108" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="APP" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="DOWNLOAD" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="UPLOAD" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Style="{StaticResource Caption}" Text="TODAY" HorizontalAlignment="Right" />
                </Grid>

                <Grid>
                    <ListBox ItemsSource="{Binding VisibleApps}" SelectedItem="{Binding SelectedApp}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Show graph" Click="ShowGraph_Click" />
                                            <MenuItem Header="Open file location"
                                                      Command="{Binding PlacementTarget.Tag.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path}" />
                                            <MenuItem Header="Copy path"
                                                      Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.Tag>
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                    </Grid.Tag>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="26" Height="26" HorizontalAlignment="Left">
                                        <Border CornerRadius="6" Background="{DynamicResource Surface2Brush}" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F8;" FontSize="13" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextDimBrush}"
                                                   Visibility="{Binding Icon, Converter={StaticResource Hidden}}" />
                                        <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                                 Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="1.5"
                                                 Visibility="{Binding IsActive, Converter={StaticResource Visible}}" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding RateDown, Converter={StaticResource Rate}}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{DynamicResource DownBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding RateUp, Converter={StaticResource Rate}}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{DynamicResource UpBrush}" />
                                    <TextBlock Grid.Column="4" Text="{Binding TodayTotal, Converter={StaticResource Bytes}}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center">
                                        <TextBlock.ToolTip>
                                            <TextBlock>
                                                <Run Text="↓" /><Run Text="{Binding TodayDown, Converter={StaticResource Bytes}, Mode=OneWay}" />
                                                <Run Text="   ↑" /><Run Text="{Binding TodayUp, Converter={StaticResource Bytes}, Mode=OneWay}" />
                                            </TextBlock>
                                        </TextBlock.ToolTip>
                                    </TextBlock>

                                    <ToggleButton Grid.Column="5" Style="{StaticResource BlockToggle}" HorizontalAlignment="Right"
                                                  IsChecked="{Binding IsBlocked, Mode=OneWay}" IsEnabled="{Binding CanBlock}"
                                                  Command="{Binding DataContext.ToggleBlockCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding VisibleApps.Count, Converter={StaticResource Hidden}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="28" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextDimBrush}" />
                        <TextBlock Style="{StaticResource Dim}" Text="Waiting for network activity…" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
