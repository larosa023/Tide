<UserControl x:Class="Tide.Views.FirewallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,4,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Open Windows Firewall" Command="{Binding OpenFirewallCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource AccentButton}" Command="{Binding BlockFileCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" />
                        <TextBlock Text="Block an app…" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Blocked apps" />
                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Blocked apps can't send or receive anything over the network. Rules live in Windows Firewall under the “Tide” group, so they stay in force even when Tide isn't running." />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12" BorderBrush="{DynamicResource DangerBrush}"
                Visibility="{Binding FirewallError, Converter={StaticResource Visible}}">
            <TextBlock TextWrapping="Wrap">
                <Run Text="Windows Firewall reported a problem: " /><Run Text="{Binding FirewallError, Mode=OneWay}" />
            </TextBlock>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <ListBox ItemsSource="{Binding BlockedApps}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="26" Height="26" HorizontalAlignment="Left">
                                    <Border CornerRadius="6" Background="{DynamicResource Surface2Brush}" />
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F8;" FontSize="13" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextDimBrush}"
                                               Visibility="{Binding Icon, Converter={StaticResource Hidden}}" />
                                    <Image Source="{Binding Icon}" Width="22" Height="22" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Dim}" Text="  ·  file not found" FontSize="11" VerticalAlignment="Center"
                                                   Visibility="{Binding Exists, Converter={StaticResource Hidden}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButton}" ToolTip="Open file location" Margin="0,0,6,0"
                                            Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding Path}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" />
                                    </Button>
                                    <Button Content="Unblock"
                                            Command="{Binding DataContext.UnblockCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding BlockedApps.Count, Converter={StaticResource Hidden}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextDimBrush}" />
                    <TextBlock Style="{StaticResource H2}" Text="Nothing is blocked" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Dim}" Text="Click Block next to any app on the Live page, or choose a program here."
                               Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
