<UserControl x:Class="Tide.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource H2}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,4,24,24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="Settings" Margin="0,0,0,16" />

            <!-- ===== Appearance ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Appearance" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource ThemeCard}"
                                     IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Tide}">
                            <StackPanel>
                                <Border Width="132" Height="74" CornerRadius="6" Background="#0B1620">
                                    <Grid Margin="10">
                                        <Border Height="16" VerticalAlignment="Top" CornerRadius="3" Background="#16293A" />
                                        <Border Height="5" Width="70" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="2" Background="#2EC4B6" Margin="0,0,0,12" />
                                        <Border Height="5" Width="44" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="2" Background="#F4A261" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="Tide" Margin="6,6,0,4" FontSize="12.5" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ThemeCard}"
                                     IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}">
                            <StackPanel>
                                <Border Width="132" Height="74" CornerRadius="6" Background="#111113">
                                    <Grid Margin="10">
                                        <Border Height="16" VerticalAlignment="Top" CornerRadius="3" Background="#212125" />
                                        <Border Height="5" Width="70" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="2" Background="#5CC8FF" Margin="0,0,0,12" />
                                        <Border Height="5" Width="44" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="2" Background="#FF8F6B" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="Dark" Margin="6,6,0,4" FontSize="12.5" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ThemeCard}"
                                     IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dusk}">
                            <StackPanel>
                                <Border Width="132" Height="74" CornerRadius="6" Background="#191724">
                                    <Grid Margin="10">
                                        <Border Height="16" VerticalAlignment="Top" CornerRadius="3" Background="#26233A" />
                                        <Border Height="5" Width="70" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="2" Background="#9CCFD8" Margin="0,0,0,12" />
                                        <Border Height="5" Width="44" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="2" Background="#F6C177" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="Dusk" Margin="6,6,0,4" FontSize="12.5" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ThemeCard}"
                                     IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}">
                            <StackPanel>
                                <Border Width="132" Height="74" CornerRadius="6" Background="#F3F6F8" BorderBrush="#D8E0E6" BorderThickness="1">
                                    <Grid Margin="10">
                                        <Border Height="16" VerticalAlignment="Top" CornerRadius="3" Background="#FFFFFF" />
                                        <Border Height="5" Width="70" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="2" Background="#0E8C82" Margin="0,0,0,12" />
                                        <Border Height="5" Width="44" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="2" Background="#D9731F" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="Light" Margin="6,6,0,4" FontSize="12.5" />
                            </StackPanel>
                        </RadioButton>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== Alerts ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Alerts" />
                    <CheckBox Style="{StaticResource Row}" IsChecked="{Binding AlertNewApps}">
                        <StackPanel>
                            <TextBlock Text="New app goes online" />
                            <TextBlock Style="{StaticResource Dim}" Text="Notify the first time an app sends or receives data." />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Row}" IsChecked="{Binding AlertSpikes}">
                        <StackPanel>
                            <TextBlock Text="Data spikes" />
                            <TextBlock Style="{StaticResource Dim}" Text="Notify when one app moves a lot of data in a short time (at most every 15 minutes per app)." />
                        </StackPanel>
                    </CheckBox>
                    <DockPanel IsEnabled="{Binding AlertSpikes}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBox Width="80" TextAlignment="Right"
                                     Text="{Binding SpikeThresholdMB, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                            <TextBlock Text="MB / minute" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Dim}" />
                        </StackPanel>
                        <TextBlock Text="Spike threshold" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ===== Monitoring ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Monitoring" />
                    <CheckBox Style="{StaticResource Row}" IsChecked="{Binding IgnoreLoopback}">
                        <StackPanel>
                            <TextBlock Text="Ignore local traffic" />
                            <TextBlock Style="{StaticResource Dim}" Text="Skip traffic to and from this PC itself (localhost), which never touches your network." />
                        </StackPanel>
                    </CheckBox>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBox Width="80" TextAlignment="Right" Text="{Binding HistoryRetentionDays, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="days" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Dim}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Keep history for" />
                            <TextBlock Style="{StaticResource Dim}" Text="Each day of history uses only a few kilobytes." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ===== Startup & window ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Startup &amp; window" />
                    <CheckBox Style="{StaticResource Row}" IsChecked="{Binding StartWithWindows}">
                        <StackPanel>
                            <TextBlock Text="Start with Windows" />
                            <TextBlock Style="{StaticResource Dim}" Text="Runs Tide at sign-in through Task Scheduler, so there's no admin prompt each time." />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Row}" IsChecked="{Binding StartMinimized}">
                        <StackPanel>
                            <TextBlock Text="Start in the tray" />
                            <TextBlock Style="{StaticResource Dim}" Text="When started with Windows, stay in the tray instead of opening the window." />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}">
                        <StackPanel>
                            <TextBlock Text="Closing the window keeps Tide running" />
                            <TextBlock Style="{StaticResource Dim}" Text="Tide keeps monitoring from the tray. Use Exit in the tray menu to quit." />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- ===== Updates ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Updates" />
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Release notes" Command="{Binding OpenReleasesCommand}" Margin="0,0,8,0" />
                            <Button Content="Check for updates" Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource AccentButton}" Content="Install update" Command="{Binding InstallUpdateCommand}"
                                    Visibility="{Binding AvailableUpdate, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionText}" />
                            <TextBlock Style="{StaticResource Dim}" Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar Margin="0,0,0,14" Maximum="1" Value="{Binding UpdateProgress, Mode=OneWay}"
                                 Visibility="{Binding IsUpdating, Converter={StaticResource Visible}}" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoCheckUpdates}">
                        <StackPanel>
                            <TextBlock Text="Check for updates automatically" />
                            <TextBlock Style="{StaticResource Dim}" Text="Looks for new releases on GitHub at startup and twice a day. Updates install only when you click Update." />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- ===== Data ===== -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Your data" />
                        <TextBlock Style="{StaticResource Dim}" Margin="0,4,12,0" TextWrapping="Wrap"
                                   Text="Usage history, alerts and settings are stored only on this PC. Tide never sends your data anywhere — the only connection it makes is to GitHub to check for updates." />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
