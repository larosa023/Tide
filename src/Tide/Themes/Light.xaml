<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#F3F6F8</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="Surface2Color">#EDF1F4</Color>
    <Color x:Key="HoverColor">#E3E9EE</Color>
    <Color x:Key="LineColor">#D8E0E6</Color>
    <Color x:Key="TextColor">#13212C</Color>
    <Color x:Key="TextDimColor">#5E6F7D</Color>
    <Color x:Key="AccentColor">#0E8C82</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <Color x:Key="DownColor">#0E8C82</Color>
    <Color x:Key="UpColor">#D9731F</Color>
    <Color x:Key="DangerColor">#D64545</Color>
    <Color x:Key="WarnColor">#B7811A</Color>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="DownBrush" Color="{StaticResource DownColor}" />
    <SolidColorBrush x:Key="UpBrush" Color="{StaticResource UpColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="DownFillBrush" Color="{StaticResource DownColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="UpFillBrush" Color="{StaticResource UpColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="{StaticResource AccentColor}" Opacity="0.16" />
</ResourceDictionary>
