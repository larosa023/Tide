<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#191724</Color>
    <Color x:Key="SurfaceColor">#1F1D2E</Color>
    <Color x:Key="Surface2Color">#26233A</Color>
    <Color x:Key="HoverColor">#2E2A45</Color>
    <Color x:Key="LineColor">#393552</Color>
    <Color x:Key="TextColor">#E0DEF4</Color>
    <Color x:Key="TextDimColor">#908CAA</Color>
    <Color x:Key="AccentColor">#EBBCBA</Color>
    <Color x:Key="AccentTextColor">#2A1A22</Color>
    <Color x:Key="DownColor">#9CCFD8</Color>
    <Color x:Key="UpColor">#F6C177</Color>
    <Color x:Key="DangerColor">#EB6F92</Color>
    <Color x:Key="WarnColor">#F6C177</Color>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="DownBrush" Color="{StaticResource DownColor}" />
    <SolidColorBrush x:Key="UpBrush" Color="{StaticResource UpColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="DownFillBrush" Color="{StaticResource DownColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="UpFillBrush" Color="{StaticResource UpColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="{StaticResource AccentColor}" Opacity="0.16" />
</ResourceDictionary>
