<Window x:Class="Tide.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Tide.Views"
        Title="Tide" Width="1120" Height="760" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/tide.ico"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStyle="None" ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar background spans both rows ===== -->
        <Border Grid.RowSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0" />

        <!-- ===== Title bar ===== -->
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/tide.ico" Width="18" Height="18" />
            <TextBlock Text="Tide" Margin="9,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="14"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="Maximize_Click"
                    ToolTip="Maximize" WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
        </StackPanel>

        <!-- ===== Navigation ===== -->
        <DockPanel Grid.Row="1" Margin="10,10,10,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9D2;" Content="Live"
                             IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=Live}" />
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="History"
                             IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=History}" />
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xEA18;" Content="Blocked apps"
                             IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=Firewall}" />
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xEA8F;"
                             IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=Alerts}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Alerts" />
                        <Border Margin="8,0,0,0" CornerRadius="8" MinWidth="18" Height="16" Padding="5,0"
                                Background="{DynamicResource AccentBrush}"
                                Visibility="{Binding UnreadAlerts, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding UnreadAlerts}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom">
                <Border Margin="4,0,4,10" Padding="12,10" CornerRadius="8" Background="{DynamicResource Surface2Brush}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="RIGHT NOW" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↓" Foreground="{DynamicResource DownBrush}" FontWeight="Bold" Width="14" />
                            <TextBlock Text="{Binding RateDown, Converter={StaticResource Rate}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="↑" Foreground="{DynamicResource UpBrush}" FontWeight="Bold" Width="14" />
                            <TextBlock Text="{Binding RateUp, Converter={StaticResource Rate}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings"
                             IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=Settings}" />
            </StackPanel>
        </DockPanel>

        <!-- ===== Pages ===== -->
        <Grid Grid.Row="1" Grid.Column="1">
            <v:LiveView Visibility="{Binding Page, Converter={StaticResource Page}, ConverterParameter=Live}" />
            <v:HistoryView Visibility="{Binding Page, Converter={StaticResource Page}, ConverterParameter=History}" />
            <v:FirewallView Visibility="{Binding Page, Converter={StaticResource Page}, ConverterParameter=Firewall}" />
            <v:AlertsView Visibility="{Binding Page, Converter={StaticResource Page}, ConverterParameter=Alerts}" />
            <v:SettingsView Visibility="{Binding Page, Converter={StaticResource Page}, ConverterParameter=Settings}" />
        </Grid>
    </Grid>
</Window>
